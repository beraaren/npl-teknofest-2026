# Sanal ortamlar / geçici bağımlılıklar
.venv/
venv/
.pydeps/
.local_deps/
__pycache__/
*.py[cod]
*.so
*.egg-info/
.pytest_cache/

# Çalışma zamanı veritabanları
data/gateway.db

# Otomatik üretilen placeholder videolar (analiz JSON'ları commit edilebilir)
data/pseudolive/videos/*.mp4

# Çıktılar, loglar ve test videoları
outputs/*
!outputs/.gitkeep
logs/*
!logs/.gitkeep
test_videos/*
!test_videos/.gitkeep
!test_videos/*.py
video_ile_test/*
!video_ile_test/.gitkeep
!video_ile_test/visualize_live.py


# Model ağırlıkları
*.gguf
*.onnx
*.pt
*.pth
# NOT: "models/" (eğik çizgi olmadan) git'te HER derinlikteki models klasörünü
# dışlar; bu yüzden kaynak kodu olan src/models/ de sessizce izlenmiyordu ve
# src/models/vlm_backend.py hiçbir commit'e girememişti. Baştaki "/" deseni
# yalnızca depo kökündeki model ağırlığı klasörüne sabitler.
/models/
checkpoints/
gpucore.*

# Çevre değişkenleri / secretlar
.env

# IDE / editör
.vscode/
.idea/
*.swp
*.swo
*~

# Sistem dosyaları
.DS_Store
Thumbs.db

# Kaynak videolar (telif / boyut nedeniyle commit edilmez)
Videos/
videos/
